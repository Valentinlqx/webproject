{
  "name": "valentin-portfolio",
  "private": true,
  "description": "Outils de développement du site (tests, icônes). Le site lui-même n'a besoin de rien.",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
